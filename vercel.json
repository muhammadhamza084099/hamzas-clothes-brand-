{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/products/catalog.js", "destination": "/catalog.js" },
    { "source": "/products/product-page.js", "destination": "/product-page.js" },
    { "source": "/products/styles.css", "destination": "/styles.css" },
    { "source": "/products/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/products/:slug", "destination": "/product.html?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}