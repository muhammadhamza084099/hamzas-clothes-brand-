# Copy this file to .env for local development.
# Never commit .env or real credentials.

APP_ENV=development
APP_URL=http://localhost:3000

# Set this when a backend API is added.
API_BASE_URL=http://localhost:4000/api

# Vercel Postgres supplies these automatically when a database is linked.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Database connection for the future modular monolith backend.
DATABASE_URL=postgresql://user:password@localhost:5432/hamzas_brand

# Server-side secrets only. Keep payment secrets out of browser code.
SESSION_SECRET=replace-with-a-long-random-value
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional services.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=